---
import Layout from "../layouts/Layout.astro";
// Nota: Eliminamos la importación de CartItem aquí si solo lo vas a usar mediante JS en el cliente
---

<Layout title="Shopping Bag - The Clinical Editorial">
  <header
    class="fixed top-0 w-full z-50 bg-white/80 backdrop-blur-md flex justify-between items-center px-6 py-3 border-b border-slate-100"
  >
    <div class="flex items-center gap-4">
      <a href="/" class="p-2 rounded-full hover:bg-slate-100">
        <span class="material-symbols-outlined text-[#005d90]">arrow_back</span>
      </a>
      <h1
        class="text-lg font-extrabold text-[#005d90] tracking-tighter font-headline"
      >
        Shopping Bag
      </h1>
    </div>
  </header>

  <main class="pt-20 pb-40 px-6 max-w-2xl mx-auto">
    <section class="mb-8">
      <h2 class="font-headline text-2xl font-bold tracking-tight mb-2">
        Revisa tu selección
      </h2>
      <p class="text-slate-500 text-sm">
        Revisa los productos que has seleccionado para comprar.
      </p>
    </section>

    <div class="space-y-6" id="cart-container">
      <div class="flex justify-center py-10">
        <p class="text-slate-400 animate-pulse">Cargando tu selección...</p>
      </div>
    </div>

    <section id="order-summary-section" class="mt-12 space-y-4">
      <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
        <h4 class="font-headline font-bold mb-4">Order Summary</h4>
        <div class="space-y-3 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-500">Subtotal</span>
            <span class="font-bold" id="subtotal">$0.00</span>
          </div>
          <div
            class="flex justify-between border-t border-slate-200 pt-4 items-baseline"
          >
            <span class="font-bold text-lg">Total</span>
            <span
              class="font-headline font-extrabold text-2xl text-[#005d90]"
              id="total">$0.00</span
            >
          </div>
        </div>
      </div>
    </section>
  </main>

  <div
    id="checkout-container"
    class="fixed bottom-20 left-0 w-full px-6 pb-6 z-50 md:bottom-0"
  >
    <div class="max-w-2xl mx-auto">
      <button
        id="checkout-whatsapp"
        class="w-full bg-gradient-to-r from-[#25D366] to-[#1DA851] text-white font-headline font-bold py-4 rounded-xl shadow-lg flex items-center justify-center gap-3 transition-transform active:scale-95"
      >
        <span class="material-symbols-outlined">chat</span>
        Finalizar pedido por WhatsApp
      </button>
    </div>
  </div>
</Layout>

<script>
  import { favoritesStore } from "../stores/favoritesStore";
  import { renderEmptyCart } from "../utils/fucntions"; // Asegúrate de que el path y nombre sean correctos
  import type { Producto } from "../utils/types";

  // Extiende la interfaz Window para incluir removeItem
  declare global {
    interface Window {
      removeItem: (id: number) => void;
    }
  }

  // 1. Definimos removeItem de forma GLOBAL para que el onclick lo encuentre
  window.removeItem = (id: number) => {
    const currentIds = favoritesStore.get();
    const newIds = currentIds.filter((favId) => {
      const cleanFavId = typeof favId === "object" ? (favId as any).id : favId;
      return Number(cleanFavId) !== Number(id);
    });

    favoritesStore.set(newIds);
    loadCartProducts(); // Recargamos la interfaz
  };

  async function loadCartProducts() {
    const ids = favoritesStore.get();
    console.log("IDs en el carrito:", ids);
    if (!ids.length) return;

    // LLAMADA A TU PROPIO SERVIDOR (Astro Endpoint)
    const response = await fetch("/api/cart-details", {
      method: "POST",
      body: JSON.stringify({ ids }),
      headers: { "Content-Type": "application/json" },
    });

    const { data } = await response.json();
    console.log("Datos recibidos para el carrito:", data);
    const container = document.getElementById("cart-container");

    const subtotalEl = document.getElementById("subtotal");
    const totalEl = document.getElementById("total");

    if (container && data && data.length > 0) {
      container.innerHTML = ""; // Limpiamos el cargando...
      let totalAccumulated = 0;
      const URL_BASE = "https://strapi.frakodev.com";
      data.forEach((product: Producto) => {
        // Asumiendo que el precio está en item.price. Si no existe, cámbialo por el campo real
        const price = product.Precio || 0;
        totalAccumulated += price;

        // Generamos el HTML del producto
        const productHtml = `
          <div class="flex gap-4 p-4 bg-white rounded-xl border border-slate-100 cart-item-data animate-fade-in">
            <div class="w-20 h-20 bg-slate-50 rounded-lg overflow-hidden flex-shrink-0">
               <img src="${URL_BASE}${product.Foto[0].url}" 
                     alt="${product.Tipo}" 
                     class="w-full h-full object-cover" />
               
            </div>
            <div class="flex-1">
              <div class="flex justify-between items-start">
                <div>
                  <p class="text-xs font-bold text-[#005d90] uppercase tracking-wider product-type">
                    ${product.Tipo || "Producto"}
                  </p>
                  <h3 class="font-bold text-slate-800 product-title">${product.Fabricantes} ${product.Marca}</h3>
                </div>
                <button onclick="removeItem(${product.id})" class="text-slate-300 hover:text-red-500 transition-colors">
                  <span class="material-symbols-outlined">delete</span>
                </button>
              </div>
              <div class="mt-2 flex justify-between items-center">
                <span class="font-extrabold text-[#005d90]">$${price.toFixed(2)}</span>
              </div>
            </div>
          </div>
        `;
        container.innerHTML += productHtml;
      });

      // Actualizar totales
      if (subtotalEl) subtotalEl.innerText = `$${totalAccumulated.toFixed(2)}`;
      if (totalEl) totalEl.innerText = `$${totalAccumulated.toFixed(2)}`;
    } else {
      renderEmptyCart();
      if (subtotalEl) subtotalEl.innerText = `$0.00`;
      if (totalEl) totalEl.innerText = `$0.00`;
    }
  }

  // Inicializar
  loadCartProducts();

  document
    .getElementById("checkout-whatsapp")
    ?.addEventListener("click", () => {
      const totalEl = document.getElementById("total");
      const total = totalEl ? totalEl.innerText.trim() : "$0.00";

      // Buscamos cada contenedor de item para armar la info
      const productDetails = Array.from(
        document.querySelectorAll(".cart-item-data"),
      )
        .map((item) => {
          const title = (
            item.querySelector(".product-title") as HTMLElement
          )?.innerText.trim();
          const type = (
            item.querySelector(".product-type") as HTMLElement
          )?.innerText.trim();

          // Formato agradable: TIPO | FABRICANTE MARCA
          return `• *${type}* - ${title}`;
        })
        .join("\n");

      const text =
        `¡Hola! Me gustaría finalizar mi pedido en *The Clinical Editorial*.\n\n` +
        `*Resumen del Pedido:*\n${productDetails}\n\n` +
        `*Monto Total:* ${total}\n\n` +
        `¿Podrían indicarme los pasos para el pago?`;

      const message = encodeURIComponent(text);
      window.open(`https://wa.me/584241468579?text=${message}`, "_blank");
    });
</script>

<style>
  .animate-fade-in {
    animation: fadeIn 0.5s ease-out forwards;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
