---
import LikeButton from "../../components/LikeButton.astro";
import ShareButton from "../../components/ShareButton.astro";
import SizeStock from "../../components/SizeStock.astro";
import Layout from "../../layouts/Layout.astro";
import type { Producto } from "../../utils/types";

// 1. OBLIGATORIO: getStaticPaths le dice a Astro qué páginas existen
export async function getStaticPaths() {
  const { STRAPI_TOKEN } = import.meta.env;

  const response = await fetch(
    "https://strapi.frakodev.com/api/productos?populate=*",
    {
      headers: {
        Authorization: `Bearer ${STRAPI_TOKEN}`,
      },
    },
  );

  const { data } = await response.json();

  // Mapeamos los productos para que Astro cree una ruta por cada ID
  return data.map((item: Producto) => ({
    params: { id: item.id.toString() },
    props: {
      producto: item,
      id: item.id,
    },
  }));
}

interface Props {
  producto: Producto;
  id: number;
}

// 2. Capturamos los datos que pasamos en getStaticPaths
const { producto } = Astro.props;
const URL_BASE = "https://strapi.frakodev.com";

// Verificamos la estructura de tu imagen en Strapi
const imagenUrl = producto.Foto?.[0]?.url
  ? `${URL_BASE}${producto.Foto[0].url}`
  : "/placeholder.jpg";

// Construimos el mensaje con saltos de línea naturales
const message = `¡Hola! Me interesa el siguiente producto:

*${producto.Tipo}*
Marca: ${producto.Marca}
Color: ${producto.Color}
Precio: $${producto.Precio}`;

// Codificamos para que los espacios y saltos de línea funcionen en la URL
const whatsappUrl = `https://wa.me/584241468579?text=${encodeURIComponent(message)}`;
---

<Layout title={`${producto.Marca} | The Clinical Editorial`}>
  <main class="max-w-4xl mx-auto px-6 md:pt-24 py-8 pb-12">
    <a
      href="/"
      class="inline-flex items-center text-slate-500 hover:text-[#005d90] mb-8 transition-colors"
    >
      <span class="material-symbols-outlined mr-2">arrow_back</span>
      Volver al catálogo
    </a>

    <div class="grid md:grid-cols-2 gap-12">
      <div class="relative group overflow-hidden">
        <button
          class="prev-btn absolute left-2 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white/80 backdrop-blur-sm text-slate-800 hidden md:group-hover:flex items-center justify-center shadow-md hover:bg-white transition-all active:scale-90"
          data-direction="-1"
        >
          <span class="material-symbols-outlined !text-xl"> chevron_left </span>
        </button>

        <div class="instagram-slider no-scrollbar">
          {
            producto.Foto &&
              producto.Foto.map((foto, index) => (
                <div class="slider-item" data-index={index}>
                  <img
                    src={`https://strapi.frakodev.com${foto.url}`}
                    alt={`${producto.Tipo} - ${index + 1}`}
                    class="w-full h-full object-cover pointer-events-none"
                    loading="lazy"
                  />
                </div>
              ))
          }
        </div>

        <button
          class="next-btn absolute right-2 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white/80 backdrop-blur-sm text-slate-800 hidden md:group-hover:flex items-center justify-center shadow-md hover:bg-white transition-all active:scale-90"
          data-direction="1"
        >
          <span class="material-symbols-outlined !text-xl">
            chevron_right
          </span>
        </button>

        {
          producto.Foto && producto.Foto.length > 1 && (
            <div class="absolute bottom-0 left-0 w-full h-12 pointer-events-none flex items-end justify-center pb-3 bg-gradient-to-t from-black/40 to-transparent">
              <div class="flex gap-1.5 dot-container">
                {producto.Foto.map((_, i) => (
                  <div
                    data-index={i}
                    class={`w-1.5 h-1.5 rounded-full bg-white shadow-sm transition-all duration-300 ${i === 0 ? "opacity-100 scale-110" : "opacity-40"}`}
                  />
                ))}
              </div>
            </div>
          )
        }
      </div>

      <div class="flex flex-col">
        <span
          class="text-sky-700 font-bold uppercase tracking-widest text-xs mb-2"
        >
          {producto.Tipo}
        </span>
        <h1
          class="text-4xl font-headline font-extrabold text-slate-900 mb-4 leading-tight"
        >
          {producto.Fabricantes}
          {producto.Marca}
        </h1>
        <p class="text-3xl font-bold text-[#005d90] mb-2">
          ${producto.Precio.toFixed(2)}
        </p>

        <SizeStock tallaStock={producto.Talla} />

        <div class="flex gap-4 mt-auto">
          <a
            href={whatsappUrl}
            target="_blank"
            class="flex-1 bg-[#005d90] flex justify-center items-center text-white py-4 rounded-xl font-bold hover:bg-[#004a73] shadow-lg shadow-sky-100 transition-all active:scale-95"
          >
            Comprar ahora
          </a>
          <button
            class="share-button p-4 border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors active:scale-95"
            data-title={`${producto.Tipo} - ${producto.Fabricantes} ${producto.Marca}`}
          >
            <span class="material-symbols-outlined text-slate-600">share</span>
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener("click", async (event) => {
    const btn = (event.target as HTMLElement).closest(".share-button");
    if (!btn) return;

    const title = btn.getAttribute("data-title") || "The Clinical Editorial";
    const url = window.location.href;

    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch (err) {
        if ((err as Error).name !== "AbortError") console.error(err);
      }
    } else {
      await navigator.clipboard.writeText(url);
      alert("Enlace del producto copiado");
    }
  });

  // Lógica de las Flechas
  const setupArrows = () => {
    const prevButtons = document.querySelectorAll(".prev-btn");
    const nextButtons = document.querySelectorAll(".next-btn");

    const handleScroll = (btn: Element, direction: number) => {
      const container = btn.parentElement?.querySelector(".instagram-slider");
      if (container) {
        const scrollAmount = container.clientWidth; // Ancho de una imagen
        container.scrollBy({
          left: scrollAmount * direction,
          behavior: "smooth",
        });
      }
    };

    prevButtons.forEach((btn) =>
      btn.addEventListener("click", () => handleScroll(btn, -1)),
    );
    nextButtons.forEach((btn) =>
      btn.addEventListener("click", () => handleScroll(btn, 1)),
    );
  };

  // Lógica de Compartir
  document.addEventListener("click", async (event) => {
    const btn = (event.target as HTMLElement).closest(".share-button");
    if (!btn) return;
    const title = btn.getAttribute("data-title") || "The Clinical Editorial";
    const url = window.location.href;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch (err) {
        if ((err as Error).name !== "AbortError") console.error(err);
      }
    } else {
      await navigator.clipboard.writeText(url);
      alert("Enlace del producto copiado");
    }
  });

  // Lógica del Slider
  const initSlider = () => {
    const slider = document.querySelector(".instagram-slider");
    const dots = document.querySelectorAll(".dot-container div");
    const prevBtn = document.querySelector(".prev-btn");
    const nextBtn = document.querySelector(".next-btn");

    if (!slider) return;

    // 1. Flechas
    const scroll = (direction: number) => {
      slider.scrollBy({
        left: slider.clientWidth * direction,
        behavior: "smooth",
      });
    };

    prevBtn?.addEventListener("click", () => scroll(-1));
    nextBtn?.addEventListener("click", () => scroll(1));

    // 2. Puntos (Dots) - Usando scroll directo en lugar de Observer para mayor precisión en sliders simples
    slider.addEventListener("scroll", () => {
      const index = Math.round(slider.scrollLeft / slider.clientWidth);
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.add("opacity-100", "scale-110");
          dot.classList.remove("opacity-40");
        } else {
          dot.classList.remove("opacity-100", "scale-110");
          dot.classList.add("opacity-40");
        }
      });
    });
  };

  // Inicializar
  initSlider();
  // Importante si usas ViewTransitions:
  document.addEventListener("astro:page-load", initSlider);
</script>

<style>
  select {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
  }

  /* Ocultar barra de scroll para Chrome, Safari y Opera */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  /* Ocultar barra de scroll para IE, Edge y Firefox */
  .no-scrollbar {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }

  .instagram-slider {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    aspect-ratio: 4 / 5;
    width: 100%;
  }

  .slider-item {
    flex: 0 0 100%; /* Esto obliga a cada item a medir el 100% exacto */
    width: 100%;
    height: 100%;
    scroll-snap-align: center;
  }

  /* Ocultar barra de scroll */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
