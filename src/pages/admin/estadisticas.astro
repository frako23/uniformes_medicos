---
import AdminLayout from "./layout.astro";
import { getInventoryStats } from "../../server/catalog/admin-stats";

const stats = await getInventoryStats();
const money = new Intl.NumberFormat("es", { style: "currency", currency: "USD" });
const number = new Intl.NumberFormat("es");
const groups = [
  { title: "Por tipo de mercancía", firstColumn: "Tipo", rows: stats.byType },
  { title: "Por talla", firstColumn: "Talla", rows: stats.bySize },
];
---
<AdminLayout title="Estadísticas">
  <section class="space-y-6">
    <div>
      <h1 class="text-3xl font-bold">Estadísticas de inventario</h1>
      <p class="mt-1 text-slate-600">El valor es existencias × precio de venta, sumando todos los productos con stock.</p>
    </div>
    {stats.totalUnits === 0 ? (
      <p class="rounded-xl bg-white p-6 text-slate-600">No hay existencias registradas.</p>
    ) : (
      <>
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Unidades en inventario</p>
            <p class="mt-1 text-3xl font-bold">{number.format(stats.totalUnits)}</p>
          </div>
          <div class="rounded-xl bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Valor del inventario</p>
            <p class="mt-1 text-3xl font-bold">{money.format(stats.totalValue)}</p>
          </div>
        </div>
        {groups.map((group) => (
          <div class="overflow-x-auto rounded-xl bg-white shadow-sm">
            <h2 class="px-4 pt-4 text-lg font-semibold">{group.title}</h2>
            <table class="min-w-full text-left text-sm">
              <thead class="border-b border-slate-200 text-slate-500">
                <tr>
                  <th class="px-4 py-3">{group.firstColumn}</th>
                  <th class="px-4 py-3 text-right">Unidades</th>
                  <th class="px-4 py-3 text-right">Valor</th>
                  <th class="px-4 py-3 text-right">% del valor</th>
                </tr>
              </thead>
              <tbody>
                {group.rows.map((row) => (
                  <tr class="border-b border-slate-100 last:border-0">
                    <td class="px-4 py-3 font-medium">{row.label}</td>
                    <td class="px-4 py-3 text-right">{number.format(row.units)}</td>
                    <td class="px-4 py-3 text-right">{money.format(row.value)}</td>
                    <td class="px-4 py-3 text-right">{stats.totalValue > 0 ? ((row.value / stats.totalValue) * 100).toFixed(1) : "0.0"}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </>
    )}
  </section>
</AdminLayout>
