---
import BuyButton from "../components/BuyButton.astro";
import FavBag from "../components/FavBag.astro";
import LikeButton from "../components/LikeButton.astro";
import ShareButton from "../components/ShareButton.astro";
import SizeStock from "../components/SizeStock.astro";
import Layout from "../layouts/Layout.astro";
import { listPublicProducts } from "../server/catalog/public-products";
import { toCatalogFilterRecord } from "../utils/catalog-filters";
import type { Producto } from "../utils/types";

let uniformes: Producto[] = [];
let catalogError = false;

try {
  uniformes = await listPublicProducts();
} catch (error) {
  catalogError = true;
  console.error(
    "No se pudo cargar el catálogo público",
    error instanceof Error ? error.message : error,
  );
}

const filterRecords = uniformes.map(toCatalogFilterRecord);
const filterData = JSON.stringify(filterRecords).replace(/</g, "\\u003c");

const genderStyles = {
  Dama: {
    icon: "female",
    bg: "bg-pink-50",
    text: "text-pink-700",
    border: "border-pink-200",
  },
  Caballero: {
    icon: "male",
    bg: "bg-blue-50",
    text: "text-blue-700",
    border: "border-blue-200",
  },
  Unisex: {
    icon: "group",
    bg: "bg-slate-50",
    text: "text-slate-700",
    border: "border-slate-200",
  },
} as const;
---

<Layout title="Uniformes Médicos 2015 | Catálogo">
  <header
    class="fixed top-0 z-50 w-full border-b border-slate-100 bg-white/90 px-4 py-3 backdrop-blur-md sm:px-6"
  >
    <div class="mx-auto flex max-w-6xl items-center justify-between">
      <a
        href="/"
        class="rounded-lg text-lg font-extrabold tracking-tighter text-[#0077B6] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2"
        aria-label="Ir al inicio de Uniformes Médicos 2015"
      >
        <span class="text-[#9D6CB2]">Uniformes</span> Médicos 2015
      </a>
      <FavBag />
    </div>
  </header>

  <main
    id="catalog-main"
    class="min-h-screen overflow-x-hidden px-4 pb-24 sm:px-6"
  >
    {catalogError && (
      <section
        class="mx-auto max-w-xl rounded-3xl border border-red-100 bg-white p-8 text-center shadow-sm"
        data-testid="catalog-error"
        role="alert"
      >
        <span class="material-symbols-outlined mb-3 text-5xl text-red-300" aria-hidden="true">error</span>
        <h1 class="text-xl font-bold text-slate-900">No pudimos cargar el catálogo</h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Intenta nuevamente en unos momentos o escríbenos para consultar la disponibilidad.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
          <button
            type="button"
            data-retry-catalog
            class="min-h-11 rounded-xl bg-[#0077B6] px-5 py-3 text-sm font-bold text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2"
          >
            Reintentar
          </button>
          <a
            href="https://wa.me/584241468579?text=Hola!%20Quisiera%20consultar%20la%20disponibilidad%20de%20sus%20uniformes"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 px-5 py-3 text-sm font-bold text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2"
          >
            Contactar por WhatsApp
          </a>
        </div>
      </section>
    )}

    {!catalogError && uniformes.length === 0 && (
      <section
        class="mx-auto max-w-xl rounded-3xl border border-slate-100 bg-white p-8 text-center shadow-sm"
        data-testid="catalog-empty"
      >
        <span class="material-symbols-outlined mb-3 text-5xl text-slate-300" aria-hidden="true">inventory_2</span>
        <h1 class="text-xl font-bold text-slate-900">No hay productos disponibles por ahora</h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Escríbenos y te ayudaremos a consultar nuevos ingresos o alternativas.
        </p>
        <a
          href="https://wa.me/584241468579?text=Hola!%20Quisiera%20consultar%20los%20uniformes%20disponibles"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-[#25D366] px-5 py-3 text-sm font-bold text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366] focus-visible:ring-offset-2"
        >
          Consultar por WhatsApp
        </a>
      </section>
    )}

    <div class="mx-auto max-w-6xl" hidden={catalogError || uniformes.length === 0}>
      <div
        id="selection-trail"
        class="sticky top-16 z-30 mb-4 rounded-2xl border border-sky-100 bg-white/95 px-4 py-3 shadow-sm backdrop-blur-md sm:px-5"
        aria-label="Resumen de tu selección"
      >
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <div class="flex items-center gap-2 text-xs font-extrabold uppercase tracking-[0.14em] text-[#005d90]">
            <span class="material-symbols-outlined text-base" aria-hidden="true">tune</span>
            <span>Tu selección</span>
          </div>
          <div id="selection-trail-items" class="flex min-w-0 flex-1 flex-wrap gap-2" aria-live="polite"></div>
        </div>
        <p id="selection-trail-hint" class="mt-1 text-xs text-slate-500">Empieza eligiendo una opción para personalizar el catálogo.</p>
      </div>

      <section
        id="guided-flow"
        class="rounded-3xl border border-slate-100 bg-white p-5 shadow-sm sm:p-8"
        aria-labelledby="guided-question"
      >
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#0077B6]">Catálogo personalizado</p>
            <h1 id="guided-question" class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
              ¿Qué deseas ver?
            </h1>
          </div>
          <p id="guided-progress" class="shrink-0 rounded-full bg-slate-100 px-3 py-2 text-xs font-bold text-slate-600" aria-live="polite">
            Paso 1 de 3
          </p>
        </div>

        <p id="guided-help" class="mt-3 max-w-xl text-sm leading-6 text-slate-600">
          Responde tres preguntas sencillas y te mostraremos prendas disponibles para ti.
        </p>

        <div class="mt-7" data-guided-step="gender" data-testid="guided-step-gender">
          <fieldset>
            <legend class="sr-only">Elige si buscas ropa de damas o caballeros</legend>
            <div class="grid gap-3 sm:grid-cols-2">
              <button
                type="button"
                data-gender-choice="Dama"
                aria-pressed="false"
                class="guided-choice min-h-16 rounded-2xl border-2 border-pink-100 bg-pink-50 px-5 py-4 text-left text-base font-extrabold text-pink-800 transition hover:border-pink-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-pink-500 focus-visible:ring-offset-2"
              >
                <span class="material-symbols-outlined mr-2 align-middle" aria-hidden="true">female</span>
                Damas
              </button>
              <button
                type="button"
                data-gender-choice="Caballero"
                aria-pressed="false"
                class="guided-choice min-h-16 rounded-2xl border-2 border-blue-100 bg-blue-50 px-5 py-4 text-left text-base font-extrabold text-blue-800 transition hover:border-blue-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2"
              >
                <span class="material-symbols-outlined mr-2 align-middle" aria-hidden="true">male</span>
                Caballeros
              </button>
            </div>
          </fieldset>
          <button
            type="button"
            data-view-all
            class="mt-5 min-h-11 rounded-xl px-3 py-2 text-sm font-bold text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-[#0077B6] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2"
          >
            Ver todo el catálogo
          </button>
        </div>

        <div class="guided-step mt-7" data-guided-step="sizes" data-testid="guided-step-sizes" hidden>
          <fieldset>
            <legend class="sr-only">Elige una o varias tallas</legend>
            <div id="size-options" class="grid grid-cols-2 gap-3 sm:grid-cols-4" role="group" aria-label="Tallas disponibles"></div>
            <p id="size-empty" class="rounded-2xl bg-amber-50 p-4 text-sm leading-6 text-amber-800" hidden>
              No encontramos tallas disponibles para esta selección. Puedes volver y cambiar el género o ver todo el catálogo.
            </p>
            <button
              type="button"
              data-any-size
              aria-label="Cualquier talla"
              class="mt-3 min-h-14 w-full rounded-2xl border-2 border-dashed border-slate-300 px-4 py-3 text-left text-sm font-bold text-slate-700 transition hover:border-[#0077B6] hover:text-[#0077B6] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2"
              aria-pressed="false"
            >
              <span class="material-symbols-outlined mr-2 align-middle" aria-hidden="true">all_inclusive</span>
              Cualquier talla
              <span class="mt-1 block text-xs font-normal text-slate-500">Continuar sin restringir por talla</span>
            </button>
          </fieldset>
          <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-between">
            <button
              type="button"
              data-guided-back="gender"
              class="min-h-11 rounded-xl px-4 py-3 text-sm font-bold text-slate-600 underline decoration-slate-300 underline-offset-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2"
            >
              Volver
            </button>
            <button
              type="button"
              data-size-continue
              class="min-h-11 rounded-xl bg-[#0077B6] px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-[#005d90] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
            >
              Continuar
            </button>
          </div>
        </div>

        <div class="guided-step mt-7" data-guided-step="garment" data-testid="guided-step-garment" hidden>
          <fieldset>
            <legend class="sr-only">Elige entre uniformes y batas</legend>
            <div class="grid gap-3 sm:grid-cols-2">
              <button
                type="button"
                data-garment-choice="uniformes"
                aria-pressed="false"
                class="min-h-16 rounded-2xl border-2 border-[#0077B6]/20 bg-sky-50 px-5 py-4 text-left text-base font-extrabold text-[#005d90] transition hover:border-[#0077B6] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2"
              >
                <span class="material-symbols-outlined mr-2 align-middle" aria-hidden="true">medical_services</span>
                Uniformes
              </button>
              <button
                type="button"
                data-garment-choice="batas"
                aria-pressed="false"
                class="min-h-16 rounded-2xl border-2 border-[#9D6CB2]/20 bg-purple-50 px-5 py-4 text-left text-base font-extrabold text-[#7a4c8f] transition hover:border-[#9D6CB2] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#9D6CB2] focus-visible:ring-offset-2"
              >
                <span class="material-symbols-outlined mr-2 align-middle" aria-hidden="true">lab_research</span>
                Batas
              </button>
            </div>
          </fieldset>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-between">
            <button
              type="button"
              data-guided-back="sizes"
              class="min-h-11 rounded-xl px-4 py-3 text-left text-sm font-bold text-slate-600 underline decoration-slate-300 underline-offset-4 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2"
            >
              Volver a tallas
            </button>
            <button
              type="button"
              data-view-all
              class="min-h-11 rounded-xl px-4 py-3 text-sm font-bold text-slate-600 underline decoration-slate-300 underline-offset-4 hover:text-[#0077B6] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2"
            >
              Ver todo el catálogo
            </button>
          </div>
        </div>

        <div id="guided-status" class="sr-only" role="status" aria-live="polite"></div>
      </section>

      <section
        id="guided-results"
        class="mt-6 rounded-3xl border border-slate-100 bg-white p-5 shadow-sm sm:p-8"
        data-testid="guided-results"
        hidden
        aria-labelledby="results-title"
      >
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#0077B6]">Tu selección</p>
            <h2 id="results-title" class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900">Prendas disponibles</h2>
            <p id="results-count" class="mt-2 text-sm text-slate-600" aria-live="polite"></p>
          </div>
          <button
            type="button"
            data-view-all
            class="min-h-11 rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold text-slate-700 hover:border-[#0077B6] hover:text-[#0077B6] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2"
          >
            Ver todo
          </button>
        </div>

        <div id="selection-summary" class="mt-4 flex flex-wrap gap-2" aria-label="Filtros activos"></div>

        <div class="mt-6 flex flex-wrap gap-2" aria-label="Cambiar selección">
          <button type="button" data-change-step="gender" class="min-h-11 rounded-xl bg-slate-100 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2">Cambiar género</button>
          <button type="button" data-change-step="sizes" class="min-h-11 rounded-xl bg-slate-100 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2">Cambiar tallas</button>
          <button type="button" data-change-step="garment" class="min-h-11 rounded-xl bg-slate-100 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2">Cambiar tipo</button>
          <button type="button" data-guided-reset class="min-h-11 rounded-xl px-3 py-2 text-xs font-bold text-slate-500 underline decoration-slate-300 underline-offset-4 hover:text-red-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2">Reiniciar selección</button>
        </div>

        <div id="product-grid" class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2" hidden>
          {
            uniformes.map((product: Producto) => {
              const style = genderStyles[product.Genero] || genderStyles.Unisex;
              return (
                <article
                  class={`product-card overflow-hidden rounded-2xl border ${style.border} bg-white shadow-sm`}
                  data-product-id={product.id}
                  data-gender={product.Genero}
                  data-category={product.Tipo}
                  hidden
                >
                  <div class="flex items-center justify-between gap-3 p-4">
                    <div class="flex items-center gap-3">
                      <div class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border ${style.bg} ${style.border}`}>
                        <span class={`material-symbols-outlined ${style.text}`} aria-hidden="true">{style.icon}</span>
                      </div>
                      <span class={`text-xs font-bold uppercase tracking-[0.1em] ${style.text}`}>{product.Genero}</span>
                    </div>
                    <div class="text-right">
                      <p class="text-sm font-bold leading-tight">{product.Fabricantes}</p>
                      <p class="text-[10px] font-medium uppercase tracking-wide text-slate-500">{product.Marca}</p>
                    </div>
                  </div>

                  <div class="group relative overflow-hidden">
                    <button
                      type="button"
                      class="prev-btn absolute left-2 top-1/2 z-20 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-slate-800 shadow-md backdrop-blur-sm transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] md:group-hover:flex"
                      data-direction="-1"
                      aria-label="Ver imagen anterior"
                    >
                      <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                    </button>

                    <div class="instagram-slider no-scrollbar">
                      {product.Foto.length > 0 ? (
                        product.Foto.map((foto, index) => (
                          <div class="slider-item" data-index={index}>
                            <img
                              src={foto.url}
                              alt={foto.alternativeText || `${product.Tipo} ${product.Color}`}
                              class="h-full w-full object-cover"
                              loading="lazy"
                            />
                          </div>
                        ))
                      ) : (
                        <div class="slider-item flex items-center justify-center bg-slate-100 text-sm text-slate-500">Sin imagen disponible</div>
                      )}
                    </div>

                    <button
                      type="button"
                      class="next-btn absolute right-2 top-1/2 z-20 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/85 text-slate-800 shadow-md backdrop-blur-sm transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] md:group-hover:flex"
                      data-direction="1"
                      aria-label="Ver imagen siguiente"
                    >
                      <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                    </button>

                    {product.Foto.length > 1 && (
                      <div class="pointer-events-none absolute bottom-0 left-0 flex h-12 w-full items-end justify-center bg-gradient-to-t from-black/40 to-transparent pb-3">
                        <div class="dot-container flex gap-1.5">
                          {product.Foto.map((_, index) => (
                            <span data-index={index} class={`h-1.5 w-1.5 rounded-full bg-white shadow-sm ${index === 0 ? "opacity-100" : "opacity-40"}`} />
                          ))}
                        </div>
                      </div>
                    )}
                  </div>

                  <div class="px-4 pb-4 pt-4">
                    <div class="mb-4 flex items-center justify-between gap-3">
                      <div class="flex items-center gap-4">
                        <LikeButton product={product} />
                        <BuyButton product={product} />
                        <ShareButton product={product} />
                        <a
                          href={`/productos/${product.documentId}`}
                          aria-label={`Ver detalles de ${product.Tipo}`}
                          class="rounded-lg p-1 text-slate-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2"
                        >
                          <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
                        </a>
                      </div>
                      <p class="text-lg font-bold text-[#005d90]">${product.Precio}</p>
                    </div>
                    <div class="space-y-1 text-sm leading-6 text-slate-800">
                      <p><span class="font-bold">Tipo:</span> {product.Tipo}</p>
                      <p><span class="font-bold">Fabricante:</span> {product.Fabricantes}</p>
                      <p><span class="font-bold">Marca:</span> {product.Marca}</p>
                      <p><span class="font-bold">Color:</span> {product.Color}</p>
                    </div>
                  </div>
                  <SizeStock tallaStock={product.Talla} class="px-4" />
                </article>
              );
            })
          }
        </div>

        <div id="no-results" class="py-12 text-center" hidden>
          <span class="material-symbols-outlined text-5xl text-slate-300" aria-hidden="true">search_off</span>
          <h3 class="mt-3 text-lg font-bold text-slate-900">No encontramos una coincidencia</h3>
          <p class="mx-auto mt-2 max-w-md text-sm leading-6 text-slate-600">
            Prueba quitando la talla, cambiando el tipo de prenda o consultando todo el catálogo.
          </p>
          <div class="mt-5 flex flex-wrap justify-center gap-3">
            <button type="button" data-empty-action="clear-sizes" class="min-h-11 rounded-xl bg-[#0077B6] px-4 py-3 text-sm font-bold text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2">Quitar tallas</button>
            <button type="button" data-empty-action="change-garment" class="min-h-11 rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2">Cambiar tipo</button>
            <button type="button" data-view-all class="min-h-11 rounded-xl border border-slate-200 px-4 py-3 text-sm font-bold text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2">Ver todo</button>
          </div>
        </div>
      </section>
    </div>
  </main>

  <div class="fixed bottom-5 right-5 z-40">
    <a
      href="https://wa.me/584241468579?text=Hola!%20Me%20interesa%20uno%20de%20sus%20uniformes"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contactar por WhatsApp"
      class="flex h-14 w-14 items-center justify-center rounded-full bg-gradient-to-br from-[#25D366] to-[#1DA851] text-white shadow-xl transition-transform focus:outline-none focus-visible:ring-2 focus-visible:ring-[#25D366] focus-visible:ring-offset-2 active:scale-90"
    >
      <span class="material-symbols-outlined text-3xl" aria-hidden="true">chat</span>
    </a>
  </div>

  {!catalogError && uniformes.length > 0 && <script id="catalog-filter-data" type="application/json" is:inline set:html={filterData}></script>}
</Layout>

<style>
  :global(.guided-choice[aria-pressed="true"]),
  :global([data-size-option][aria-pressed="true"]),
  :global([data-any-size][aria-pressed="true"]) {
    position: relative;
    border-color: #0077b6;
    background: #eff8fc;
    color: #005d90;
    box-shadow: 0 0 0 3px rgba(0, 119, 182, 0.14), 0 8px 18px rgba(0, 93, 144, 0.1);
    transform: translateY(-1px);
  }

  :global(.guided-choice[aria-pressed="true"])::after,
  :global([data-size-option][aria-pressed="true"])::after,
  :global([data-any-size][aria-pressed="true"])::after {
    align-items: center;
    background: #0077b6;
    border: 2px solid white;
    border-radius: 9999px;
    color: white;
    content: "check";
    display: flex;
    font-family: "Material Symbols Outlined";
    font-size: 1rem;
    font-weight: 700;
    height: 1.5rem;
    justify-content: center;
    line-height: 1;
    position: absolute;
    right: 0.75rem;
    top: 0.75rem;
    width: 1.5rem;
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .instagram-slider {
    display: flex;
    aspect-ratio: 4 / 5;
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    background: #f1f5f9;
  }

  .slider-item {
    height: 100%;
    width: 100%;
    flex: 0 0 100%;
    scroll-snap-align: center;
  }

  [data-guided-step][hidden],
  [data-testid="guided-results"][hidden],
  #product-grid[hidden],
  #no-results[hidden] {
    display: none;
  }
</style>

<script>
  import {
    filterCatalogRecords,
    getAvailableSizeLabels,
    sortSizeLabels,
    type CatalogFilterRecord,
    type GarmentGroup,
    type GuidedCatalogSelection,
    type GuidedGender,
    type GuidedStep,
  } from "../utils/catalog-filters";

  const dataElement = document.getElementById("catalog-filter-data");
  const records = dataElement
    ? (JSON.parse(dataElement.textContent || "[]") as CatalogFilterRecord[])
    : [];
  const flow = document.getElementById("guided-flow");
  const results = document.getElementById("guided-results");
  const progress = document.getElementById("guided-progress");
  const question = document.getElementById("guided-question");
  const help = document.getElementById("guided-help");
  const status = document.getElementById("guided-status");
  const sizeOptions = document.getElementById("size-options");
  const sizeEmpty = document.getElementById("size-empty");
  const continueSizes = document.querySelector<HTMLButtonElement>("[data-size-continue]");
  const anySizeButton = document.querySelector<HTMLButtonElement>("[data-any-size]");
  const resultGrid = document.getElementById("product-grid");
  const resultCount = document.getElementById("results-count");
  const selectionSummary = document.getElementById("selection-summary");
  const selectionTrailItems = document.getElementById("selection-trail-items");
  const selectionTrailHint = document.getElementById("selection-trail-hint");
  const noResults = document.getElementById("no-results");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".product-card"));
  const stepPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-guided-step]"));

  const initialSelection: GuidedCatalogSelection = {
    step: "gender",
    view: "guided",
    gender: null,
    sizeLabels: [],
    garmentGroup: null,
  };

  let selection: GuidedCatalogSelection = { ...initialSelection };

  const labels: Record<GuidedGender, string> = {
    Dama: "Damas",
    Caballero: "Caballeros",
  };

  const groupLabels: Record<GarmentGroup, string> = {
    uniformes: "Uniformes",
    batas: "Batas",
  };

  function copySelection(next: GuidedCatalogSelection): GuidedCatalogSelection {
    return { ...next, sizeLabels: sortSizeLabels(next.sizeLabels) };
  }

  function setHistory(next: GuidedCatalogSelection, replace = false) {
    const state = { guidedCatalog: copySelection(next) };
    const hash = next.view === "all" ? "#catalogo" : `#${next.step}`;
    if (replace) {
      window.history.replaceState(state, "", hash);
    } else {
      window.history.pushState(state, "", hash);
    }
    selection = copySelection(next);
    render();
  }

  function setStatus(message: string) {
    if (status) status.textContent = message;
  }

  function renderSelectionTrail() {
    if (!selectionTrailItems) return;
    selectionTrailItems.innerHTML = "";

    if (selection.view === "all") {
      const chip = document.createElement("span");
      chip.className = "inline-flex items-center gap-1.5 rounded-full bg-sky-50 px-3 py-1.5 text-xs font-bold text-[#005d90]";
      chip.innerHTML = '<span class="material-symbols-outlined text-sm" aria-hidden="true">apps</span>';
      chip.append("Todo el catálogo");
      selectionTrailItems.append(chip);
      if (selectionTrailHint) selectionTrailHint.textContent = "Explorando todas las prendas disponibles.";
      return;
    }

    const values: Array<{ label: string; value: string; icon: string }> = [];
    if (selection.gender) values.push({ label: "Género", value: labels[selection.gender], icon: "person" });
    if (selection.sizeLabels.length) {
      values.push({ label: "Tallas", value: selection.sizeLabels.join(", "), icon: "straighten" });
    } else if (selection.gender) {
      values.push({ label: "Tallas", value: "Cualquiera", icon: "all_inclusive" });
    }
    if (selection.garmentGroup) values.push({ label: "Tipo", value: groupLabels[selection.garmentGroup], icon: "medical_services" });

    values.forEach(({ label, value, icon }) => {
      const chip = document.createElement("span");
      chip.className = "inline-flex max-w-full items-center gap-1.5 rounded-full bg-sky-50 px-3 py-1.5 text-xs font-bold text-[#005d90]";
      chip.innerHTML = `<span class="material-symbols-outlined shrink-0 text-sm" aria-hidden="true">${icon}</span>`;
      const text = document.createElement("span");
      text.className = "truncate";
      text.textContent = `${label}: ${value}`;
      chip.append(text);
      selectionTrailItems.append(chip);
    });

    if (selectionTrailHint) {
      selectionTrailHint.textContent = !selection.gender
        ? "Empieza eligiendo una opción para personalizar el catálogo."
        : !selection.garmentGroup
          ? "Selección guardada. Elige una talla y luego el tipo de prenda."
          : "Selección completa. Mostrando prendas disponibles.";
    }
  }

  function renderSelectedStates() {
    document.querySelectorAll<HTMLButtonElement>("[data-gender-choice]").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.genderChoice === selection.gender));
    });

    document.querySelectorAll<HTMLButtonElement>("[data-garment-choice]").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.garmentChoice === selection.garmentGroup));
    });

    if (anySizeButton) {
      anySizeButton.setAttribute("aria-pressed", String(selection.sizeLabels.length === 0));
    }
  }

  function renderSummary() {
    if (!selectionSummary) return;
    selectionSummary.innerHTML = "";
    if (selection.view === "all") {
      const chip = document.createElement("span");
      chip.className = "rounded-full bg-slate-100 px-3 py-2 text-xs font-bold text-slate-700";
      chip.textContent = "Todo el catálogo";
      selectionSummary.append(chip);
      return;
    }

    const values = [
      selection.gender ? labels[selection.gender] : "Sin género",
      selection.sizeLabels.length ? selection.sizeLabels.join(", ") : "Cualquier talla",
      selection.garmentGroup ? groupLabels[selection.garmentGroup] : "Sin tipo",
    ];
    values.forEach((value) => {
      const chip = document.createElement("span");
      chip.className = "rounded-full bg-sky-50 px-3 py-2 text-xs font-bold text-[#005d90]";
      chip.textContent = value;
      selectionSummary.append(chip);
    });
  }

  function updateSizeOptions() {
    if (!sizeOptions || !selection.gender) return;
    const availableSizes = getAvailableSizeLabels(records, selection.gender);
    sizeOptions.innerHTML = "";

    availableSizes.forEach((size) => {
      const button = document.createElement("button");
      const selected = selection.sizeLabels.includes(size);
      button.type = "button";
      button.dataset.sizeOption = size;
      button.className = "min-h-14 rounded-2xl border-2 border-slate-200 bg-white px-4 py-3 text-center text-base font-extrabold text-slate-700 transition hover:border-[#0077B6] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2";
      button.setAttribute("aria-pressed", String(selected));
      button.setAttribute("aria-label", `Talla ${size}`);
      button.textContent = size;
      button.addEventListener("click", () => {
        const isSelected = selection.sizeLabels.includes(size);
        selection.sizeLabels = isSelected
          ? selection.sizeLabels.filter((label) => label !== size)
          : sortSizeLabels([...selection.sizeLabels, size]);
        setHistory({ ...selection, step: "sizes", view: "guided" });
        setStatus(isSelected ? `Talla ${size} quitada.` : `Talla ${size} seleccionada.`);
      });
      sizeOptions.append(button);
    });

    if (sizeEmpty) sizeEmpty.hidden = availableSizes.length > 0;
    if (continueSizes) continueSizes.disabled = availableSizes.length === 0;
    if (anySizeButton) anySizeButton.setAttribute("aria-pressed", String(selection.sizeLabels.length === 0));
  }

  function renderResults() {
    const matchingRecords = selection.view === "all"
      ? records
      : filterCatalogRecords(records, selection);
    const visibleIds = new Set(matchingRecords.map((record) => String(record.productId)));

    cards.forEach((card) => {
      card.hidden = !visibleIds.has(card.dataset.productId || "");
    });

    if (resultGrid) resultGrid.hidden = matchingRecords.length === 0;
    if (noResults) noResults.hidden = matchingRecords.length > 0;
    if (resultCount) {
      resultCount.textContent = `${matchingRecords.length} ${matchingRecords.length === 1 ? "producto disponible" : "productos disponibles"}`;
    }
    renderSummary();
  }

  function render() {
    if (!flow || !results) return;

    renderSelectionTrail();
    renderSelectedStates();

    const isResults = selection.step === "results" || selection.view === "all";
    const questions: Record<GuidedStep, string> = {
      gender: "¿Qué deseas ver?",
      sizes: "¿Qué tallas deseas ver?",
      garment: "¿Uniformes o batas?",
      results: selection.view === "all" ? "Todo el catálogo" : "Prendas disponibles",
    };
    const progressText = selection.view === "all"
      ? "Catálogo completo"
      : selection.step === "results"
        ? "Resultados"
        : `Paso ${["gender", "sizes", "garment"].indexOf(selection.step) + 1} de 3`;

    if (question) question.textContent = questions[selection.step];
    if (progress) progress.textContent = progressText;
    if (help) help.textContent = isResults
      ? "Puedes cambiar cualquier respuesta o explorar todo el catálogo."
      : "Responde tres preguntas sencillas y te mostraremos prendas disponibles para ti.";

    stepPanels.forEach((panel) => {
      panel.hidden = isResults || panel.dataset.guidedStep !== selection.step;
    });
    results.hidden = !isResults;

    if (selection.step === "sizes") updateSizeOptions();
    if (isResults) renderResults();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-gender-choice]").forEach((button) => {
    button.addEventListener("click", () => {
      const gender = button.dataset.genderChoice as GuidedGender;
      setHistory({
        step: "sizes",
        view: "guided",
        gender,
        sizeLabels: [],
        garmentGroup: null,
      });
      setStatus(`Elegiste ${labels[gender]}. Ahora selecciona tus tallas.`);
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-garment-choice]").forEach((button) => {
    button.addEventListener("click", () => {
      const garmentGroup = button.dataset.garmentChoice as GarmentGroup;
      setHistory({ ...selection, step: "results", view: "guided", garmentGroup });
      setStatus(`Mostrando ${groupLabels[garmentGroup].toLocaleLowerCase()}.`);
      results?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  anySizeButton?.addEventListener("click", () => {
    setHistory({ ...selection, step: "sizes", view: "guided", sizeLabels: [] });
    setStatus("Se mostrarán productos de cualquier talla.");
  });

  continueSizes?.addEventListener("click", () => {
    setHistory({ ...selection, step: "garment", view: "guided" });
    setStatus("Ahora elige entre uniformes y batas.");
  });

  document.querySelectorAll<HTMLButtonElement>("[data-guided-back]").forEach((button) => {
    button.addEventListener("click", () => {
      const step = button.dataset.guidedBack as GuidedStep;
      setHistory({ ...selection, step, view: "guided" });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-change-step]").forEach((button) => {
    button.addEventListener("click", () => {
      const step = button.dataset.changeStep as GuidedStep;
      setHistory({ ...selection, step, view: "guided" });
      document.getElementById("guided-flow")?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-guided-reset]").forEach((button) => {
    button.addEventListener("click", () => {
      setHistory(initialSelection);
      setStatus("Selección reiniciada.");
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-view-all]").forEach((button) => {
    button.addEventListener("click", () => {
      setHistory({ ...initialSelection, step: "results", view: "all" });
      setStatus("Mostrando todo el catálogo disponible.");
      results?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-empty-action]").forEach((button) => {
    button.addEventListener("click", () => {
      if (button.dataset.emptyAction === "clear-sizes") {
        setHistory({ ...selection, step: "results", view: "guided", sizeLabels: [] });
      } else {
        setHistory({ ...selection, step: "garment", view: "guided" });
      }
    });
  });

  document.querySelector<HTMLButtonElement>("[data-retry-catalog]")?.addEventListener("click", () => {
    window.location.reload();
  });

  window.addEventListener("popstate", (event) => {
    const next = event.state?.guidedCatalog as GuidedCatalogSelection | undefined;
    selection = next ? copySelection(next) : { ...initialSelection };
    render();
  });

  if (flow && records.length) {
    window.history.replaceState({ guidedCatalog: copySelection(initialSelection) }, "", "#gender");
    render();
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      const slide = entry.target as HTMLElement;
      const card = slide.closest("article");
      const index = slide.dataset.index;
      if (!card || index === undefined) return;
      card.querySelectorAll<HTMLElement>(".dot-container [data-index]").forEach((dot) => {
        const active = dot.dataset.index === index;
        dot.classList.toggle("opacity-100", active);
        dot.classList.toggle("opacity-40", !active);
      });
    });
  }, { threshold: 0.6 });

  document.querySelectorAll<HTMLElement>(".slider-item").forEach((item) => observer.observe(item));

  document.querySelectorAll<HTMLButtonElement>(".prev-btn, .next-btn").forEach((button) => {
    button.addEventListener("click", () => {
      const slider = button.parentElement?.querySelector<HTMLElement>(".instagram-slider");
      if (!slider) return;
      const direction = Number(button.dataset.direction || "1");
      slider.scrollBy({ left: slider.clientWidth * direction, behavior: "smooth" });
    });
  });
</script>
