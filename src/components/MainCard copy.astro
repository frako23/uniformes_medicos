---
import { Image } from "astro:assets";
import type { Producto } from "../utils/types";
const { producto, serverURL } = Astro.props;

// Definimos la interfaz de las Props para este componente
interface Props {
  producto: Producto;
  serverURL: string;
}

// 🛡️ Blindaje de seguridad: Si no hay producto, no renderizamos nada o mostramos error
if (!producto) {
  return null;
}

const hasImage = producto?.Foto && producto.Foto.length > 0;
const imagePath = hasImage ? producto.Foto[0].url : null;
// Construimos la URL completa o usamos un placeholder local
const finalImageUrl = imagePath
  ? `${serverURL}${imagePath}`
  : "/images/no-photo.png"; // Asegúrate de tener esta imagen en /public/images/

console.log("finalImageUrl:", finalImageUrl);
---

<div class="max-w-sm bg-white border border-gray-200 rounded-lg shadow">
  <a href="#">
    <Image
      class="rounded-t-lg bg-white"
      src={finalImageUrl || "https://via.placeholder.com/400"}
      alt={producto.Fabricantes || "Uniforme Médico"}
      width={500}
      height={500}
    />
  </a>
  <div class="p-5 flex space-x-10">
    <a href="#">
      <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900">
        {producto.Genero}
      </h5>
    </a>
    <a
      href="/"
      class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300"
    >
      Descubre más
      <svg
        class="rtl:rotate-180 w-3.5 h-3.5 ms-2"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 14 10"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M1 5h12m0 0L9 1m4 4L9 9"></path>
      </svg>
    </a>
  </div>
</div>
