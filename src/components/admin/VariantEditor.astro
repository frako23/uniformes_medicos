---
import type { ProductVariant } from "../../db/schema";
import OptionSelect from "./OptionSelect.astro";

interface Props {
  variants?: ProductVariant[];
  sizeOptions: string[];
}

const { variants = [], sizeOptions } = Astro.props;
const rows = variants.length ? variants : [{ sizeLabel: "", quantity: 0 } as ProductVariant];
---
<fieldset class="space-y-3 rounded-xl border border-slate-200 p-4">
  <legend class="px-2 text-sm font-semibold">Tallas y existencias</legend>
  <div id="variants" class="space-y-3">
    {rows.map((variant, index) => (
      <div class="variant-row grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]">
        <OptionSelect id={`size-label-${index}`} name="sizeLabel" label="Talla" options={sizeOptions} value={variant.sizeLabel} />
        <label class="text-sm">Cantidad<input name="quantity" type="number" min="0" step="1" value={variant.quantity} required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label>
        <button type="button" class="remove-variant self-end rounded-lg border border-slate-300 px-3 py-2" aria-label="Eliminar talla">×</button>
      </div>
    ))}
  </div>
  <template id="variant-template">
    <div class="variant-row grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]">
      <OptionSelect id="size-label-template" name="sizeLabel" label="Talla" options={sizeOptions} />
      <label class="text-sm">Cantidad<input name="quantity" type="number" min="0" step="1" value="0" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label>
      <button type="button" class="remove-variant self-end rounded-lg border border-slate-300 px-3 py-2" aria-label="Eliminar talla">×</button>
    </div>
  </template>
  <button id="add-variant" type="button" class="rounded-lg border border-slate-300 px-3 py-2 text-sm hover:bg-slate-50">Agregar talla</button>
</fieldset>
