---
import { ADMIN_NAV_ITEMS, isActiveNavItem } from "./nav-items";

interface Props {
  title?: string;
  csrfToken?: string;
}

const { title = "Panel administrativo", csrfToken = "" } = Astro.props;
const pathname = Astro.url.pathname;
const links = [
  ...ADMIN_NAV_ITEMS.map((item) => ({ ...item, current: isActiveNavItem(item, pathname) })),
  { href: "/", label: "Ver vitrina", current: false },
];
const linkClass = "block rounded-md px-3 py-3 hover:bg-slate-100 hover:underline md:inline-block md:px-2 md:py-2";
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Uniformes Médicos 2015</title>
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-2 px-4 py-4 sm:px-6">
        <a href="/admin" class="font-bold">Panel de administración</a>
        <nav class="flex items-center gap-2 text-sm md:gap-4" aria-label="Administración">
          <ul class="hidden items-center gap-2 md:flex">
            {links.map((link) => (
              <li>
                <a href={link.href} aria-current={link.current ? "page" : undefined} class:list={[linkClass, link.current && "font-semibold underline"]}>{link.label}</a>
              </li>
            ))}
          </ul>
          <details class="relative md:hidden">
            <summary class="flex min-h-[44px] cursor-pointer list-none items-center rounded-md border border-slate-300 px-3 py-2">Menú</summary>
            <ul class="absolute right-0 z-20 mt-2 w-56 rounded-lg border border-slate-200 bg-white p-2 shadow-lg">
              {links.map((link) => (
                <li>
                  <a href={link.href} aria-current={link.current ? "page" : undefined} class:list={[linkClass, link.current && "font-semibold underline"]}>{link.label}</a>
                </li>
              ))}
            </ul>
          </details>
          <button id="logout" data-csrf={csrfToken} class="min-h-[44px] rounded-md border border-slate-300 px-3 py-2 hover:bg-slate-50">Salir</button>
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
      <slot />
    </main>
    <script>
      const button = document.querySelector<HTMLButtonElement>("#logout");
      button?.addEventListener("click", async () => {
        await fetch("/api/admin/auth/logout", {
          method: "POST",
          headers: { "x-csrf-token": button.dataset.csrf ?? "" },
        });
        window.location.href = "/admin/login";
      });
    </script>
  </body>
</html>
