---
const { product } = Astro.props;

// Construimos el mensaje con saltos de línea naturales
const message = `¡Hola! Me interesa el siguiente producto:

*${product.Tipo}*
Marca: ${product.Marca}
Color: ${product.Color}
Precio: $${product.Precio}`;

// Codificamos para que los espacios y saltos de línea funcionen en la URL
const whatsappUrl = `https://wa.me/584241468579?text=${encodeURIComponent(message)}`;
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Consultar ${product.Tipo} por WhatsApp`}
  class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg p-1 active:scale-90 transition-transform focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077B6] focus-visible:ring-offset-2"
>
  <span class="material-symbols-outlined text-slate-500" aria-hidden="true"> shopping_cart </span>
</a>
