---
interface Props {
  id: string;
  name: string;
  price: number;
  image: string;
  badge?: string;
  size: string;
}

const { id, name, price, image, badge, size } = Astro.props;
---

<div class="flex gap-4 group cart-item" data-id={id}>
  <div
    class="w-24 h-32 rounded-xl overflow-hidden bg-surface-container-low flex-shrink-0"
  >
    <img class="w-full h-full object-cover" src={image} alt={name} />
  </div>
  <div class="flex flex-col justify-between py-1 flex-grow">
    <div>
      <div class="flex justify-between items-start">
        <h3 class="font-headline font-bold text-on-surface leading-tight">
          {name}
        </h3>
        <button
          class="text-outline hover:text-error transition-colors remove-item"
        >
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>
      {
        badge && (
          <p class="text-xs font-semibold text-secondary uppercase tracking-widest mt-1">
            {badge}
          </p>
        )
      }
      <p class="text-on-surface-variant text-sm mt-2">
        Size: <span class="text-on-surface font-medium">{size}</span>
      </p>
    </div>
    <div class="flex justify-between items-end">
      <div
        class="flex items-center gap-3 bg-surface-container-low px-3 py-1 rounded-full"
      >
        <button class="material-symbols-outlined text-xs decrease"
          >remove</button
        >
        <span class="text-sm font-bold quantity">1</span>
        <button class="material-symbols-outlined text-xs increase">add</button>
      </div>
      <span class="font-headline font-bold text-lg">${price.toFixed(2)}</span>
    </div>
  </div>
</div>
