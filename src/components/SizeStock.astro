---
import type { TallaStock } from "../utils/types";

interface Props {
  tallaStock: TallaStock[];
  class?: string;
}
const { tallaStock, class: customClass } = Astro.props;
const availableSizes = tallaStock.filter((size) => size.cantidad_actual > 0);
---

<div class={`py-4 ${customClass || ""}`}>
  <p
    class="text-[10px] font-bold uppercase tracking-widest text-slate-500 mb-3"
  >
    Tallas disponibles
  </p>

  <div class="flex gap-2 overflow-x-auto no-scrollbar py-1" role="list" aria-label="Tallas con existencias">
    {
      availableSizes.length > 0 ? availableSizes.map((size) => (
        <span role="listitem" class="flex min-h-11 min-w-[64px] flex-shrink-0 flex-col items-center justify-center rounded-lg border-2 border-[#005d90] bg-[#005d90]/5 px-3 py-2 text-[#005d90]">
          <span class="text-xs font-bold font-['Manrope']">{size.Talla}</span>
          <span class="text-[10px] font-medium italic text-blue-500">
            {size.cantidad_actual < 3
              ? `Solo ${size.cantidad_actual}`
              : "En stock"}
          </span>
        </span>
      )) : (
        <span role="listitem" class="text-sm text-slate-500">Sin tallas disponibles</span>
      )
    }
  </div>
</div>
