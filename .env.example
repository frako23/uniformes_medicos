# PostgreSQL target database (use a separate value per environment)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uniformes_medicos

# Public image storage write token; server-only
BLOB_READ_WRITE_TOKEN=

# Source used only by the one-time migration scripts
