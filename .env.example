# PostgreSQL instalado directamente (usa un valor separado por entorno)
# Si la aplicación corre en el mismo servidor, usa localhost o 127.0.0.1.
DATABASE_URL=postgresql://USUARIO:PASSWORD@127.0.0.1:5432/uniformes_medicos

# Public image storage write token; server-only
BLOB_READ_WRITE_TOKEN=

# Source used only by the one-time migration scripts
STRAPI_URL=https://tu-instancia-de-strapi.com
STRAPI_TOKEN=

# Owner bootstrap and public URL
ADMIN_EMAIL=propietaria@example.com
ADMIN_PASSWORD=
PUBLIC_SITE_URL=http://localhost:4321
# HOST=0.0.0.0
# PORT=4321
MIGRATION_REPORT_DIR=.local/migration-reports
